# Ignore all saved plans
saves/*.json

# But keep the default plan
!saves/default.json

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# User-specific files
.vscode/
.idea/
*.swp
.DS_Store

# Virtual environment
venv/
env/
ENV/

# Test files
test_*.py
*_test.py

# Documentation and debug files
*.md
debug_*.py
*_debug.py
debug.log
*.log

# Distribution / packaging
dist/
build/
*.egg-info/